.DS_Store
# AppleDouble files left by copies from a network share
._*
# key material and local configuration never belong in the tree (tools/public_check.py also refuses them)
*.pem
*.key
*.p12
local.conf
# desk-camera frames
.claude-code-eyes/
# Blender backups
*.blend1
.pytest_cache/
build/
**/build/
**/__pycache__/
*.pyc
.venv/
.env
.env.*
!*.example
sdkconfig.old
managed_components/
# generated by idf.py from sdkconfig.defaults
firmware/boards/*/sdkconfig
firmware/boards/*/dependencies.lock

# Lab firmware generated configuration
lab/receiver/sdkconfig

# The lab's test-stimulus firmware stays private (owner, 2026-11-20): it is the only part that
# transmits, it is GPL-3.0-only, and nothing in the Guardian builds or tests needs it.
lab/emitter/
